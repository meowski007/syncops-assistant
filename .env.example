# ==============================================================================
# SyncOps Assistant - Environment Configuration Template
# NOTE: Copy this file to .env and fill in values if using external integrations.
# Default runs fully without any external API keys or Slack credentials.
# All data generated and processed is strictly SYNTHETIC for educational purposes.
# ==============================================================================

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Database Configuration
# Default relative path points to data/syncops.db
DATABASE_PATH=data/syncops.db

# API Service Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_URL=http://localhost:8000

# Streamlit Dashboard Configuration
DASHBOARD_PORT=8501

# Observability & Alerts
FAILURE_RATE_THRESHOLD=0.05
ALERT_COOLDOWN_MINUTES=15

# LLM Triage Configuration (Optional)
# Leave blank to use the deterministic, rule-based triage fallback engine (no credentials required)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=

# Slack Integration Configuration (Optional)
# Leave blank to run the zero-credential mock mode (app/slack/mock.py)
SLACK_BOT_TOKEN=xoxb-your-bot-token-placeholder
SLACK_APP_TOKEN=xapp-your-app-token-placeholder
SLACK_SIGNING_SECRET=your-signing-secret-placeholder
SLACK_ALERT_CHANNEL=#syncops-alerts
